#############################################
# Environment Template (.env.example)
# Copy to .env and fill required values
# Do NOT commit real secrets to version control
#############################################

# App
# HTTP server port (e.g., 3000)
PORT=
# Node environment: development | production | test
NODE_ENV=
# Docker Compose project name
COMPOSE_PROJECT_NAME=
# 32-byte encryption key for data at rest
ENCRYPTION_KEY=
# 16-byte initialization vector paired with ENCRYPTION_KEY
INITIATION_VECTOR=
# Public base URL for this server (e.g., https://api.example.com)
BASE_URL=
# UI density preset: dense | comfortable | compact
DATA_DENSITY=
# Expose Swagger/OpenAPI UI and JSON ("true" | "false").
# Defaults to enabled when NODE_ENV != production, disabled otherwise.
SWAGGER_ENABLED=

# Database (Postgres)
# Credentials for local/dev (use provider values in staging/prod)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_HOST=
# Use "true" if your provider requires SSL (e.g., Render, AWS RDS)
POSTGRES_SSL=

# JWT
# Secret used to sign tokens
JWT_SECRET=
# Expiration (e.g., 1h, 7d)
JWT_EXPIRES_IN=

# Payments - Flutterwave
# API secret key (keep private)
FLUTTERWAVE_SECRET_KEY=
# Webhook verification hash configured in dashboard
FLUTTERWAVE_WEBHOOK_HASH=

# Content partners
ALLRITES_API_KEY=

# Notifications - OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Default: https://api.onesignal.com
ONESIGNAL_BASE_URL=

# Frontend URLs
# Web app base URL used for redirects and deep links
FRONTEND_URL=
# Admin interface URL (local dev or deployed)
FRONTEND_ADMIN_URL=

# AWS & CloudFront
# AWS credentials and storage settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ROLE_ARN=
AWS_BUCKET_NAME=
AWS_CF_DOMAIN=
AWS_CF_KEY_PAIR_ID=

# CloudFront signing key (choose one approach)
# If using inline env, use \n-escaped newlines for PEM content
PRIVATE_KEY=
# Or point to a PEM file (unenc. PKCS#8 or RSA)
PRIVATE_KEY_PATH=

# Agora RTM/RTC
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Token expiry in seconds (e.g., 7200)
AGORA_TOKEN_EXPIRY=

# Admin (dev-only seeding)
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

# TLS (development)
# Paths to local dev cert/key (PEM)
SSL_KEY_PATH=
SSL_CERT_PATH=
